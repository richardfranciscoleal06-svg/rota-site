# Required for signed sessions and secure cookie validation.
SESSION_SECRET=
# Example: openssl rand -hex 32

# Supabase project configuration for Vercel serverless API + frontend runtime.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required only for the initial bootstrap of the first admin account.
BOOTSTRAP_TOKEN=
# Example: openssl rand -hex 32

# Recommended for local development.
NODE_ENV=development
